{
  "name": "loongagent-vscode",
  "displayName": "loongagent",
  "description": "loongagent in the editor: a local agent in its own sidebar.",
  "private": true,
  "version": "0.0.1",
  "publisher": "loongagent",
  "engines": { "vscode": "^1.138.0" },
  "categories": ["AI", "Other"],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The agent works on this workspace and runs its own tools under its own sandbox and approval rules."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "loongagent", "title": "loongagent", "icon": "media/loong-48.png" }
      ]
    },
    "views": {
      "loongagent": [
        { "id": "loongagent.chat", "name": "Chat", "type": "webview" }
      ]
    },
    "commands": [
      {
        "command": "loongagent.openChat",
        "title": "loongagent: Open Chat"
      },
      {
        "command": "loongagent.locateBinary",
        "title": "loongagent: Locate the binary"
      },
      {
        "command": "loongagent.attachSelection",
        "title": "loongagent: Attach selection to chat"
      },
      {
        "command": "loongagent.reviewChanges",
        "title": "loongagent: Review the changes from a turn",
        "description": "Opens the before/after diff for the files a turn changed. Normally reached from the button in the reply."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "loongagent.attachSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "loongagent",
      "properties": {
        "loongagent.path": {
          "type": "string",
          "default": "loongagent",
          "scope": "machine",
          "description": "The loongagent binary. A bare name is looked up on PATH; Locate stores an explicit choice."
        },
        "loongagent.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Passed as --model when the server starts."
        },
        "loongagent.autoApprove": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Turn approval prompts off for this workspace (recorded as permissions.relaxed)."
        },
        "loongagent.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "machine",
          "description": "Extra arguments for loongagent server."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs && tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.138.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
